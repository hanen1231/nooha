{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nooha-site-cms",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nooha-cms-db",
      "database_id": "604996e9-31c3-4d38-aef7-c792e85dc8bd",
      "migrations_dir": "migrations"
    }
  ]
}
