{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nooha-site-cms",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nooha-cms-db",
      "database_id": "431efb93-5a5f-48fa-be7c-ecc49677ba00"
    }
  ]
}
